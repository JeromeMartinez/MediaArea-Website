# This file is a "template" of what your parameters.yml file should look like
# Set parameters here that may be different on each deployment target of the app, e.g. development, staging, production.
# https://symfony.com/doc/current/best_practices/configuration.html#infrastructure-related-configuration
parameters:
    database_host: 127.0.0.1
    database_port: ~
    database_name: symfony
    database_user: root
    database_password: ~
    # You should uncomment this if you want to use pdo_sqlite
    #database_path: '%kernel.project_dir%/var/data/data.sqlite'

    mailer_transport: smtp
    mailer_host: 127.0.0.1
    mailer_user: ~
    mailer_password: ~

    # A secret key that's used to generate certain security-related tokens
    secret: ThisTokenIsNotSoSecretChangeIt

    # Payment Bundle
    # Key which encrypts the data of the payments, made by vendor/bin/generate-defuse-key
    payment_secret: ~
    # Credentials of the NVP API of Paypal
    paypal_username: ~
    paypal_password: ~
    paypal_signature: ~
    # true to use the sandbox of Paypal, with the credentials of a sandbox account.
    # The development environment always uses it
    paypal_sandbox: false
    # Simulation of the payments, to test them: no payment provider is called and no money is involved.
    # Never on a public website: everybody would get what a payment gives without paying
    payment_simulation: false

    # Recaptcha
    recaptcha_public: ~
    recaptcha_private: ~

    # MediaBin
    mediabin_local_path: ~
    mediabin_external_enabled: false
    mediabin_external_openstack_auth_url: ~
    mediabin_external_openstack_region: ~
    mediabin_external_openstack_container: ~
    mediabin_external_openstack_username: ~
    mediabin_external_openstack_password: ~
    mediabin_external_openstack_tenant_id: ~

    # MediaConch config
    mco_check_folder: /some/folder/
    mco_mc_host: 127.0.0.1
    mco_mc_port: 4242
    mco_mc_api_version: 1.15
    mco_mail_host: ~
    mco_mail_scheme: ~
    mco_mail_base_url: ~
    mco_api_base_url: https://mediaarea.net/
    mco_api_token: ThisTokenIsNotSoSecretChangeIt
