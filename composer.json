{
    "name": "mediaarea/mediaarea-website",
    "license": "MIT",
    "type": "project",
    "description": "MediaArea website",
    "autoload": {
        "psr-4": { "": ["src/", "lib/"] },
        "classmap": [ "app/AppKernel.php" ]
    },
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-simplexml": "*",
        "defuse/php-encryption": "^2.4",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "easycorp/easyadmin-bundle": "^5.9",
        "erusev/parsedown": "^1.8",
        "friendsofsymfony/jsrouting-bundle": "^3.6",
        "geoip2/geoip2": "^3.4",
        "google/recaptcha": "^2.1",
        "incenteev/composer-parameter-handler": "^2.3",
        "knplabs/knp-menu-bundle": "^3.8",
        "matomo/device-detector": "^6.5",
        "mpdf/mpdf": "^8.3",
        "nelmio/cors-bundle": "^2.6",
        "php-opencloud/openstack": "^3.17",
        "stof/doctrine-extensions-bundle": "^1.15",
        "stripe/stripe-php": "^22.1",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/intl": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/web-link": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/extra-bundle": "^3.29",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.30",
        "vich/uploader-bundle": "^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "scripts": {
        "symfony-scripts": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@php bin/console cache:clear --no-warmup",
            "@php bin/console assets:install web"
        ],
        "post-install-cmd": [
            "@symfony-scripts"
        ],
        "post-update-cmd": [
            "@symfony-scripts"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "public-dir": "web",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        }
    }
}
